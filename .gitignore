# Environment & secrets
# Keep real root and backend environment files untracked.
# Compose uses root .env; local Python also reads backend/.env.
.env
.env.local

# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Coverage / logs / editor + OS metadata
.coverage
coverage.xml
htmlcov/
*.log
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db

# Runtime data: database and uploaded deployment documents
storage/
