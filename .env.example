# ---------------------------------------------------------------------------
# Production Deployment Scheduler (PDS)
# One shared environment file for all deployment modes.
# docker-compose.yml: app + PostgreSQL; forces AI_PROVIDER=builtin.
# docker-compose.Ollama_hosted.yml: full local AI stack; forces ollama_rag.
#
# The standard Compose command requires no Ollama or external model.
# The built-in assistant answers supported read-only PDS questions directly
# from the application/database.
#
# Future organisation AI integration can be enabled using the generic AI_*
# settings below without redesigning the PDS UI or permissions model.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# ---------------------------------------------------------------------------
# MCP
# Disabled for now.
# Enable later only if external AI clients such as Claude, Copilot, Codex,
# or ChatGPT need to connect to PDS tools through MCP.
# ---------------------------------------------------------------------------

MCP_ENABLED=false

# Generate a random secret if MCP is enabled later:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_KEY=replace-with-long-random-mcp-secret

# ---------------------------------------------------------------------------
# PDS Assistant
# ---------------------------------------------------------------------------

# Used by standalone Python/container/pod deployments. Both supplied Compose
# files explicitly override this value, even when shell/.env settings differ.
# Keep future-ready Ollama settings here without affecting the lightweight stack.
AI_PROVIDER=ollama_rag

# Used by Ollama and hosted/corporate AI providers; ignored in built-in mode.
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=512
AI_CONTEXT_WINDOW=8192
# 0 selects Ollama's automatic CPU thread count.
AI_NUM_THREADS=0
AI_KEEP_ALIVE=30m
# Cache validated plans, never database results.
AI_PLAN_CACHE_SECONDS=300
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# ---------------------------------------------------------------------------
# Future Hosted / Organisation AI
#
# AI_API_KEY remains empty for local modes. Preserve these settings for
# an approved future gateway. Standalone/pod deployments use AI_PROVIDER;
# supplied Compose files force their selected provider.
#
# Later, your organisation can provide its approved Claude / Azure OpenAI /
# Copilot / internal AI gateway details here.
#
# Example future standalone/pod switch (Compose needs an explicit override):
#   AI_PROVIDER=org_gateway
#   AI_API_KEY=<organisation-secret>
#   AI_MODEL=<approved-model-or-deployment>
#   AI_BASE_URL=https://your-org-ai-gateway.example.com/v1
#   AI_API_PATH=/responses
# ---------------------------------------------------------------------------

AI_API_KEY=
AI_MODEL=qwen3:8b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_BASE_URL=http://ollama:11434
AI_API_PATH=/responses
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AI_ANTHROPIC_VERSION=2023-06-01

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me-in-production

# Docker-to-Docker connection.
# Do NOT change "postgres" to localhost when PDS runs through Docker Compose.
DATABASE_URL=postgresql+psycopg://scheduler:change-me-in-production@postgres:5432/scheduler

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------

STORAGE_DIR=./storage/deployments

# ---------------------------------------------------------------------------
# Authentication / Sessions
# ---------------------------------------------------------------------------

# Generate a proper random secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# 8-hour session
SESSION_MINUTES=480

# ---------------------------------------------------------------------------
# Bootstrap Administrator
# Only used when the initial administrator does not already exist.
# ---------------------------------------------------------------------------

BOOTSTRAP_ADMIN_USERNAME=admin

# Change this for anything beyond a temporary local POC.
BOOTSTRAP_ADMIN_PASSWORD=admin2024

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

FRONTEND_DIST=./frontend/dist

# ---------------------------------------------------------------------------
# CORS
# Leave empty because the frontend and API are served from the same application.
# ---------------------------------------------------------------------------

CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------

TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Application Port
# ---------------------------------------------------------------------------

APP_PORT=18000
