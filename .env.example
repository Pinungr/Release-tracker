# ---------------------------------------------------------------------------
# Production Deployment Scheduler - environment template
# Copy to .env in the project root and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- Database --------------------------------------------------------------
# Compose uses postgres:5432 internally and binds host localhost:15432 only.
# For local Python, backend/.env may override DATABASE_URL to localhost:15432.
# Compose process environment values take precedence over backend/.env.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://scheduler:change-me-in-production@postgres:5432/scheduler

# --- File storage ----------------------------------------------------------
# Attachments are written to <STORAGE_DIR>/<booking-id>/<category>/
STORAGE_DIR=./storage/deployments

# --- Authentication --------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
SESSION_MINUTES=480

# --- Bootstrap administrator -----------------------------------------------
# Used only when no administrator with this username exists yet. The password
# is hashed with bcrypt on first start and never stored in clear text.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin2024

# --- Compiled frontend -----------------------------------------------------
# The same process serves this directory as the web UI (`npm run build`).
FRONTEND_DIST=./frontend/dist

# --- CORS ------------------------------------------------------------------
# Leave empty. The monolith serves the UI from its own origin and the Vite dev
# server proxies /api, so no cross-origin request is ever made. Set it only if
# you deliberately host the UI on a different origin.
CORS_ORIGINS=

# --- Locale ----------------------------------------------------------------
TIMEZONE=Asia/Kolkata

# --- Host port ---------------------------------------------------------------
# The app always listens on 8000 inside the container; this is only the port
# published on the host. Windows reserves blocks of ports for Hyper-V/WinNAT,
# and 8000 often falls inside one, which fails with "An attempt was made to
# access a socket in a way forbidden by its access permissions". Check with:
#   netsh interface ipv4 show excludedportrange protocol=tcp
# then pick a port outside every listed range (9000 is usually free).
APP_PORT=8000

# --- Read-only AI / MCP integration ---------------------------------------
# Process-level switch for exposing the external /mcp transport. Runtime user
# access is controlled separately by the Release controls AI Enable master button and Groups. Even when this
# is true, the admin master AI switch defaults OFF and must be enabled before
# anybody can use PDS AI. The key is a READ-ONLY connector credential; never
# place it in frontend JavaScript.
MCP_ENABLED=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_KEY=replace-with-another-long-random-string


# --- In-app PDS Assistant --------------------------------------------------
# Default local POC mode: fast deterministic read-only answers from PDS data.
# No Ollama, model download, AI API key, or API credits are required.
AI_PROVIDER=builtin
AI_TIMEOUT_SECONDS=120

# --- Future organisation/hosted AI gateway -------------------------------
# Leave these blank while AI_PROVIDER=builtin.
# When your organisation provides an approved Responses-compatible AI gateway,
# change AI_PROVIDER=org_gateway (or another non-builtin provider name) and fill
# the values supplied by the platform team. The PDS chat UI, permissions and
# read-only query layer do not need to change.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_API_PATH=/responses
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
