; systemd unit for the Production Deployment Scheduler.
;
;   sudo cp deploy/pds.service /etc/systemd/system/pds.service
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now pds
;
; Adjust WorkingDirectory/ExecStart if you install somewhere other than
; /srv/pds. Configuration is read from /srv/pds/.env by the application
; itself, so there is no EnvironmentFile here — that avoids systemd and
; python-dotenv disagreeing about quoting and '#' inside passwords.

[Unit]
Description=Production Deployment Scheduler
Documentation=file:///srv/pds/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=pds
Group=pds

# `python -m app` imports `app.main`, so the working directory must be the
# backend package root.
WorkingDirectory=/srv/pds/backend
ExecStart=/srv/pds/backend/.venv/bin/python -m app --host 127.0.0.1 --port 8000 --workers 1

# Bound to localhost above: put nginx/Caddy in front for TLS. To expose the
# port directly instead, use --host 0.0.0.0.

Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pds
Environment=PYTHONUNBUFFERED=1

# --- Hardening ------------------------------------------------------------
# The app only ever writes to storage/ (SQLite database + uploaded documents).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/pds/storage
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
