# ---------------------------------------------------------------------------
# Production Deployment Scheduler - environment template
# Copy to .env in the project root and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- Database --------------------------------------------------------------
# PostgreSQL is the production/runtime database. It remains internal to the
# Docker network and is not published on host port 5432.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://scheduler:change-me-in-production@postgres:5432/scheduler

# --- File storage ----------------------------------------------------------
# Attachments are written to <STORAGE_DIR>/<booking-id>/<category>/
STORAGE_DIR=./storage/deployments

# --- Authentication --------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
SESSION_MINUTES=480

# --- Bootstrap administrator -----------------------------------------------
# Used only when no administrator with this username exists yet. The password
# is hashed with bcrypt on first start and never stored in clear text.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin2024

# --- Compiled frontend -----------------------------------------------------
# The same process serves this directory as the web UI (`npm run build`).
FRONTEND_DIST=./frontend/dist

# --- CORS ------------------------------------------------------------------
# Leave empty. The monolith serves the UI from its own origin and the Vite dev
# server proxies /api, so no cross-origin request is ever made. Set it only if
# you deliberately host the UI on a different origin.
CORS_ORIGINS=

# --- Locale ----------------------------------------------------------------
TIMEZONE=Asia/Kolkata
